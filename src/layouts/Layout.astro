---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='en' translate='no'>
  <head>
    <meta charset='UTF-8' />
    <meta name='author' content='Santiago Ramos' />
    <meta name='description' content='Print-friendly, minimalist resume.' />
    <meta
      name='keywords'
      content='resume, cv, curriculum vitae, web, mobile, development, frontend, backend, ui'
    />
    <meta name='viewport' content='width=device-width' />
    <meta name='google' content='notranslate' />
    <link rel='icon' type='image/png' href='/logo.png' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class='font-mono bg-slate-950 print:bg-white print:!text-slate-800'>
    <slot />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (navigator.language.startsWith('es')) {
      document.body.setAttribute('translate', 'no')
    }
  })
</script>
