---
import { resume } from '../../utils/schema'
import Section from '../Section.astro'
import ProCard from '../ProCard.astro'
---

<Section title='Proyectos'>
  <div class='-mx-3 pt-1 grid grid-cols-1 gap-3 print:grid-cols-3 print:gap-2 md:grid-cols-2 lg:grid-cols-3'>
    {resume?.projects.map((project) => (
      <ProCard {...project} />
    ))}
  </div>
</Section>
