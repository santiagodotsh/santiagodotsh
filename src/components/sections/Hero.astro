---
import { resume } from '../../utils/schema'
import CodePen from '../icons/CodePen.astro'
import Email from '../icons/Email.astro'
import GitHub from '../icons/GitHub.astro'
import HeroButton from '../HeroButton.astro'
import LinkedIn from '../icons/LinkedIn.astro'
import Pin from '../icons/Pin.astro'
import Portfolio from '../icons/Portfolio.astro'
import Section from '../Section.astro'
import Phone from '../icons/Phone.astro'

const SOCIAL_ICONS: Record<string, string | any> = {
  GitHub,
  LinkedIn,
  CodePen
}
---

<Section>
  <div class='w-full print:-mb-4 h-auto flex flex-row justify-start md:justify-between space-x-4 items-center'>
    <header class='w-full h-auto flex flex-col justify-start items-start space-y-1.5'>
      <h1 class='font-sans print:text-slate-800 text-slate-100 mb-[2px] text-2xl font-bold'>
        {resume?.basics.name}
      </h1>
      <p class='text-pretty max-w-md text-sm print:text-slate-800 text-slate-300'>
        {resume?.basics.label}
      </p>
      <p class='max-w-md text-xs print:text-slate-800 text-slate-300'>
        <a
          class='group/maps inline-flex gap-x-1.5 align-baseline items-center leading-none hover:underline'
          href={resume?.basics.location.maps}
          rel='noopener noreferrer'
          target='_blank'
          title='Google Maps'
        >
          <Pin />
          {resume?.basics.location.city}, {resume?.basics.location.country} ({resume?.basics.location.timezone})
        </a>
      </p>
      <div class='w-full relative print:pt-3.5 print:-mx-[11px] h-auto print:h-[58px] flex flex-row print:flex-wrap justify-start items-center gap-x-1.5 print:gap-0.5 pt-1'>
        <HeroButton
          title='Portfolio'
          url={resume?.basics.url ?? '#'}
        >
          <Portfolio />
          <span class='hidden text-xs print:text-slate-800 print:block'>
            {resume?.basics.url.slice(8)}
          </span>
        </HeroButton>
        <HeroButton
          title='Email'
          url={`mailto:${resume?.basics.email}`}
        >
          <Email />
          <span class='hidden text-xs print:text-slate-800 print:block'>
            {resume?.basics.email}
          </span>
        </HeroButton>
        <HeroButton
          title='Phone'
          url={`tel:${resume?.basics.phone}`}
        >
          <Phone />
          <span class='hidden text-xs print:text-slate-800 print:block'>
            {resume?.basics.phone}
          </span>
        </HeroButton>
        {resume?.basics.profiles.map(({ network, url, username }) => {
          const Icon = SOCIAL_ICONS[network]
          return (
            <HeroButton
              title={network}
              url={`${url}${username}`}
            >
              {Icon && <Icon />}
              <span class='hidden text-xs print:text-slate-800 print:block'>
                {`${network === 'LinkedIn' ? '/in/' : '/'}${username}`}
              </span>
            </HeroButton>
        )})}
      </div>
    </header>
    <figure class='absolute opacity-70 grayscale-[50%] sm:opacity-100 -z-10 sm:z-auto top-[32px] sm:top-auto right-[16px] sm:right-auto sm:relative flex bg-[#172033] py-2 print:border-y print:border-slate-200 shrink-0 w-28 overflow-hidden rounded-md'>
      <div class="absolute -mt-[8px] sm:hidden h-full w-full bg-gradient-to-r from-[#020618] to-transparent" />
      <img
        alt='profile picture'
        class='w-full h-full rounded-md object-cover'
        draggable={false}
        src='./me.png'
      />
    </figure>
  </div>
</Section>

<script>
  const header = document.querySelector('header')?.offsetHeight
  const figure = document.querySelector('figure')

  if (header && figure) {
    figure.style.height = `${header}px`
  }
</script>
