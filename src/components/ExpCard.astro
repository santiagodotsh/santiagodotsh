---
interface Props {
  name: string
  position: string
  remote: boolean
  start: {
    year: string
    month: string
  }
  end?: {
    year: string
    month: string
  }
  summary: string
  url: string
}

const {
  name,
  position,
  remote,
  start,
  end,
  summary,
  url
} = Astro.props

const months = [
  'ene',
  'feb',
  'mar',
  'abr',
  'may',
  'jun',
  'jul',
  'ago',
  'sep',
  'oct',
  'nov',
  'dic'
]
---

<div class='w-full h-auto flex flex-col justify-start items-start space-y-2'>
  <div class='w-full h-auto flex flex-col justify-start items-start space-y-1.5'>
    <div class='w-full h-auto flex flex-row justify-between items-center'>
      <h3 class='inline-flex font-sans text-slate-100 items-center justify-center gap-x-1.5 font-medium'>
        <a
          href={url}
          target='_blank'
          rel='noopener noreferrer'
          class='hover:underline'
        >
          {name}
        </a>
        {remote && (
          <div class='flex justify-center items-center rounded-md px-2 py-0.5 bg-slate-900'>
            <span class='text-xs font-medium text-slate-400 text-nowrap'>
              Remote
            </span>
          </div>
        )}
      </h3>
      <span class='font-light text-[15px] font-sans text-slate-300 tabular-nums'>
        {`${months[+start.month - 1]} ${start.year} ~ ${end ? `${months[+end.month - 1]} ${end.year}` : 'presente'}`}
      </span>
    </div>
    <h4 class='text-sm text-slate-100 leading-none text-left'>
      {position}
    </h4>
  </div>
  <p class='text-pretty text-slate-300  mt-2 text-xs'>
    {summary}
  </p>
</div>
