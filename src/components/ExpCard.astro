---
import { formatDate } from '../utils/format-date'
import type { Time } from '../utils/format-date'

interface Props {
  name: string
  position: string
  modality: {
    onSite?: boolean
    remote?: boolean
    hybrid?: boolean
  }
  start: Time
  end?: Time
  summary: string
  url: string
}

const months = [
  'ene',
  'feb',
  'mar',
  'abr',
  'may',
  'jun',
  'jul',
  'ago',
  'sep',
  'oct',
  'nov',
  'dic'
]

const {
  name,
  position,
  modality,
  start,
  end,
  summary,
  url
} = Astro.props
---

<div class='w-full h-auto flex flex-col justify-start items-start space-y-2'>
  <div class='w-full h-auto flex flex-col justify-start items-start space-y-1.5'>
    <div class='w-full h-auto flex flex-row justify-between items-center'>
      <h3 class='inline-flex font-sans print:text-slate-800 text-slate-100 items-center justify-center gap-x-1.5 font-medium'>
        <a
          href={url}
          target='_blank'
          rel='noopener noreferrer'
          class='hover:underline print:text-slate-800'
        >
          {name}
        </a>

        <div class='flex justify-center items-center rounded-md px-2 py-0.5 bg-slate-900'>
          <span class='text-xs font-medium print:text-slate-800 text-slate-400 text-nowrap'>
            {modality.onSite && 'Presencial'}
            {modality.remote && 'Remoto'}
            {modality.hybrid && 'Híbrido'}
          </span>
        </div>

        <span class='font-light hidden sm:block text-[11px] opacity-65 print:text-slate-800 font-sans text-slate-300 tabular-nums'>
          {formatDate(start, end).totalString}
        </span>
      </h3>
      <div class='flex flex-row justify-end items-center'>
        <span class='font-light text-[15px] print:text-slate-800 font-sans text-slate-300 tabular-nums'>
          {`${months[+start.month - 1]} ${start.year} ~`}
        </span>

        {!!!end ? (
          <span class='animate-pulse -mb-[3px] -ml-[1px] print:hidden text-green-500 text-[32px]'>
            &bull;
          </span>

          <span class='font-light hidden print:block text-[15px] print:text-slate-800 font-sans text-slate-300 tabular-nums'>
            &nbsp;presente
          </span>
        ) : (
          <span class='font-light text-[15px] print:text-slate-800 font-sans text-slate-300 tabular-nums'>
            &nbsp;{`${months[+end.month - 1]} ${end.year}`}
          </span>
        )}
      </div>
    </div>
    <h4 class='text-sm print:text-slate-800 text-slate-100 leading-none text-left'>
      {position}
    </h4>
  </div>
  <p class='text-pretty print:text-slate-800 text-slate-300  mt-2 text-xs'>
    {summary}
  </p>
</div>
